<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <!-- Desde la Entrega 2 el proyecto es un backend Spring Boot (CLAUDE.md, seccion 3).
         El padre fija las versiones de todas las dependencias y plugins, asi que la
         construccion sigue siendo reproducible sin declarar versiones sueltas. -->
    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>4.1.2</version>
        <relativePath/>
    </parent>

    <groupId>edu.unal.planta</groupId>
    <artifactId>simulador-planta</artifactId>
    <version>2.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Simulador de Monitoreo y Mantenimiento de Planta</name>
    <description>
        Backend del simulador de plantas industriales con maquinas que reportan lecturas de sensores.
        Proyecto del curso Estructuras de Datos, Universidad Nacional de Colombia.
        Entrega 1: estructuras lineales. Entrega 2: arboles, monticulos y arbol de segmentos.
    </description>

    <properties>
        <!-- Java 21 LTS: el padre de Spring Boot lo traduce a maven.compiler.release. -->
        <java.version>21</java.version>
    </properties>

    <!-- Unicas dependencias permitidas (CLAUDE.md, seccion 3). -->
    <dependencies>
        <!-- API REST: Spring MVC, Tomcat embebido y Jackson para JSON. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc</artifactId>
        </dependency>

        <!-- Pruebas: JUnit Jupiter, Spring Test y MockMvc para probar los endpoints. -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webmvc-test</artifactId>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>simulador-planta</finalName>
        <plugins>
            <!-- Empaqueta un jar ejecutable con sus dependencias: java -jar target/simulador-planta.jar.
                 La clase principal se declara porque, mientras exista la App de Swing (hasta el
                 commit 3 de la seccion 17), hay dos metodos main en el proyecto. -->
            <plugin>
                <groupId>org.springframework.boot</groupId>
                <artifactId>spring-boot-maven-plugin</artifactId>
                <configuration>
                    <mainClass>edu.unal.planta.AplicacionPlanta</mainClass>
                </configuration>
            </plugin>

            <!-- Documentacion en linea de codigo exigida por el enunciado:
                 ./mvnw clean javadoc:javadoc deja el resultado en target/reports/apidocs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <configuration>
                    <locale>es</locale>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <author>true</author>
                    <notimestamp>true</notimestamp>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
