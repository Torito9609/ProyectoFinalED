<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>edu.unal.planta</groupId>
    <artifactId>simulador-planta</artifactId>
    <version>1.0-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Simulador de Monitoreo y Mantenimiento de Planta</name>
    <description>
        Simulador de una planta industrial con tres maquinas que reportan lecturas de sensores.
        Proyecto del curso Estructuras de Datos, Universidad Nacional de Colombia.
        Usa cinco estructuras lineales: arreglo dinamico, cola circular propia, cola FIFO,
        cola con prioridad por niveles y pila.
    </description>

    <properties>
        <!-- Java 21 LTS: se compila con release=21 para que el bytecode sea portable
             aunque el JDK instalado sea mas nuevo. -->
        <maven.compiler.release>21</maven.compiler.release>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>

        <!-- Unica dependencia externa permitida en el proyecto. -->
        <junit.version>5.14.4</junit.version>

        <!-- Versiones de plugins fijadas para que la construccion sea reproducible. -->
        <plugin.compiler.version>3.14.1</plugin.compiler.version>
        <plugin.surefire.version>3.6.0</plugin.surefire.version>
        <plugin.jar.version>3.4.2</plugin.jar.version>
        <plugin.javadoc.version>3.12.0</plugin.javadoc.version>
    </properties>

    <dependencies>
        <!-- junit-jupiter agrupa api, params y engine en un solo artefacto. -->
        <dependency>
            <groupId>org.junit.jupiter</groupId>
            <artifactId>junit-jupiter</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
    </dependencies>

    <build>
        <finalName>simulador-planta</finalName>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <version>${plugin.compiler.version}</version>
            </plugin>

            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${plugin.surefire.version}</version>
            </plugin>

            <!-- Genera un jar ejecutable: no hay dependencias de runtime, asi que
                 basta con declarar la clase principal en el manifiesto. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <version>${plugin.jar.version}</version>
                <configuration>
                    <archive>
                        <manifest>
                            <mainClass>edu.unal.planta.App</mainClass>
                        </manifest>
                    </archive>
                </configuration>
            </plugin>

            <!-- Documentacion en linea de codigo exigida por el enunciado:
                 mvn javadoc:javadoc deja el resultado en target/reports/apidocs. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
                <version>${plugin.javadoc.version}</version>
                <configuration>
                    <locale>es</locale>
                    <encoding>UTF-8</encoding>
                    <docencoding>UTF-8</docencoding>
                    <charset>UTF-8</charset>
                    <author>true</author>
                    <notimestamp>true</notimestamp>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
